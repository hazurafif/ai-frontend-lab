# Your chat backend (required). The Vite dev server proxies /api/* to this
# URL (same mapping as the old Next route handlers — see docs/migration.md).
# FastAPI backend (ai-backend-lab): uv run uvicorn app.main:app --port 8000
BACKEND_URL="http://localhost:8000"

# Optional: path on your backend that accepts AI SDK chat requests.
# BACKEND_CHAT_PATH="/api/chat"

# Optional: deploy the static build under a sub-path (e.g. "/demo").
# Used as Vite `base` + the router basename.
# VITE_BASE_PATH="/demo"

# Removed in the Vite migration (docs/migration.md decision 2):
#   MODELS_BASE_URL / MODELS_API_KEY — the server-side model-list source.
# Configure an llm connection in Settings → Model instead; the model catalog
# is aggregated by the backend (GET /connections/models) or listed from the
# saved connection client-side.