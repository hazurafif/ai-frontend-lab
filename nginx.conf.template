# Production reverse proxy for the Vite SPA. Serves the static bundle and
# maps the client's /api/* calls onto BACKEND_URL — the same path rewriting
# the dev server does in vite.config.ts (see docs/migration.md table).
#
# __BACKEND_URL__ is replaced at container start by the Dockerfile's CMD
# (a static proxy_pass so nginx resolves the host at startup via
# /etc/hosts — Docker Desktop / the compose extra_hosts entry).

server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml;

  # SPA fallback — deep links (/chat/<id>, /settings, /share/<id>) serve
  # index.html and let React Router take over.
  location / {
    try_files $uri $uri/ /index.html;
  }

  # Static assets are fingerprinted by Vite — cache them hard.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  location /api/ {
    # Order matters — most specific rules first (mirrors rewriteApiPath).
    rewrite ^/api/chat/threads/(.*)$      /threads/$1 break;
    rewrite ^/api/chat/notifications/(.*)$ /notifications/$1 break;
    rewrite ^/api/chat$                   /api/chat break; # BACKEND_CHAT_PATH
    rewrite ^/api/auth/login$             /login break;
    rewrite ^/api/auth/refresh$           /refresh break;
    rewrite ^/api/auth/register$          /register break;
    rewrite ^/api/auth/me$                /users/me break;
    rewrite ^/api/auth/users(.*)$         /users$1 break;
    rewrite ^/api/auth/allowed-models$    /allowed-models break;
    rewrite ^/api/share/shared/(.*)$      /shared/$1 break;
    rewrite ^/api/share/(.*)$             /threads/$1/share break;
    rewrite ^/api/preferences$            /users/me/preferences break;
    rewrite ^/api/setup$                  /users/me/setup break;
    rewrite ^/api/(.*)$                   /$1 break; # generic strip

    # POST /api/setup → /users/me/onboarding (the Next route split methods).
    if ($request_method = POST) {
      rewrite ^/api/setup$ /users/me/onboarding break;
    }

    proxy_pass __BACKEND_URL__;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Chat + notification streams are SSE — never buffer.
    proxy_buffering off;
    proxy_read_timeout 3600s;
    client_max_body_size 25m;
  }
}